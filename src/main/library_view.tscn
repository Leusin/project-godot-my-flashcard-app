[gd_scene load_steps=2 format=3]

[ext_resource type="Theme" path="res://src/main/main_theme.tres" id="1_theme"]

[node name="LibraryContainer" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("1_theme")
theme_override_constants/separation = 16

[node name="LibraryHeading" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "내 덱"

[node name="LibraryHint" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "학습할 덱을 선택하세요."

[node name="DeckListScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="DeckList" type="VBoxContainer" parent="DeckListScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="EmptyDecksLabel" type="Label" parent="."]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "덱이 없습니다."
horizontal_alignment = 1

[node name="ImportButton" type="Button" parent="."]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "덱 가져오기 (.md)"

[node name="ImportStatusLabel" type="Label" parent="."]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "가져오기 완료"
horizontal_alignment = 1

[node name="ImportDialog" type="FileDialog" parent="."]
title = "가져올 Markdown 덱 선택"
initial_position = 2
size = Vector2i(720, 900)

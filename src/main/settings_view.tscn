[gd_scene load_steps=9 format=3]

[ext_resource type="Theme" path="res://src/main/main_theme.tres" id="1_theme"]
[ext_resource type="Texture2D" path="res://assets/icons/toggle_on.svg" id="2_toggle_on"]
[ext_resource type="Texture2D" path="res://assets/icons/toggle_off.svg" id="3_toggle_off"]
[ext_resource type="Texture2D" path="res://assets/icons/chevron_left.svg" id="4_back"]
[ext_resource type="PackedScene" path="res://src/main/app_header.tscn" id="5_header"]

[sub_resource type="StyleBoxFlat" id="StyleBoxSection"]
bg_color = Color(1, 1, 1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0, 0, 0, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxLine" id="StyleBoxSeparator"]
color = Color(0.82, 0.82, 0.8, 1)
thickness = 2

[sub_resource type="StyleBoxEmpty" id="StyleBoxIconButton"]

[node name="SettingsView" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("1_theme")
theme_override_constants/separation = 32

[node name="Header" parent="." instance=ExtResource("5_header")]
layout_mode = 2

[node name="BackFromSettingsButton" type="Button" parent="Header/LeftActions"]
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
icon = ExtResource("4_back")
icon_alignment = 1
theme_override_styles/normal = SubResource("StyleBoxIconButton")
theme_override_styles/pressed = SubResource("StyleBoxIconButton")
theme_override_styles/hover = SubResource("StyleBoxIconButton")
theme_override_styles/disabled = SubResource("StyleBoxIconButton")
theme_override_styles/focus = SubResource("StyleBoxIconButton")
tooltip_text = "뒤로"

[node name="SettingsTitle" type="Label" parent="Header/TitleSlot"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 36
text = "설정"
horizontal_alignment = 0
vertical_alignment = 1

[node name="SettingsStatusLabel" type="Label" parent="."]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "작업 완료"
horizontal_alignment = 1
autowrap_mode = 3

[node name="SettingsScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
scroll_deadzone = 12

[node name="Content" type="VBoxContainer" parent="SettingsScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

[node name="InteractionTitle" type="Label" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "학습"

[node name="InteractionPanel" type="PanelContainer" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxSection")

[node name="Margin" type="MarginContainer" parent="SettingsScroll/Content/InteractionPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="InteractionContent" type="VBoxContainer" parent="SettingsScroll/Content/InteractionPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HapticsRow" type="HBoxContainer" parent="SettingsScroll/Content/InteractionPanel/Margin/InteractionContent"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="HapticsText" type="VBoxContainer" parent="SettingsScroll/Content/InteractionPanel/Margin/InteractionContent/HapticsRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="HapticsLabel" type="Label" parent="SettingsScroll/Content/InteractionPanel/Margin/InteractionContent/HapticsRow/HapticsText"]
layout_mode = 2
theme_override_font_sizes/font_size = 27
text = "햅틱 사용"

[node name="HapticsDescription" type="Label" parent="SettingsScroll/Content/InteractionPanel/Margin/InteractionContent/HapticsRow/HapticsText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.45, 0.45, 1)
theme_override_font_sizes/font_size = 21
text = "카드 판정선을 넘을 때 짧게 진동합니다."
autowrap_mode = 3

[node name="HapticsToggle" type="CheckButton" parent="SettingsScroll/Content/InteractionPanel/Margin/InteractionContent/HapticsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
tooltip_text = "햅틱 켜기 또는 끄기"
theme_override_icons/checked = ExtResource("2_toggle_on")
theme_override_icons/checked_disabled = ExtResource("2_toggle_on")
theme_override_icons/unchecked = ExtResource("3_toggle_off")
theme_override_icons/unchecked_disabled = ExtResource("3_toggle_off")
theme_override_styles/normal = SubResource("StyleBoxIconButton")
theme_override_styles/pressed = SubResource("StyleBoxIconButton")
theme_override_styles/hover = SubResource("StyleBoxIconButton")
theme_override_styles/disabled = SubResource("StyleBoxIconButton")
theme_override_styles/focus = SubResource("StyleBoxIconButton")

[node name="DataTitle" type="Label" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "데이터"

[node name="DataPanel" type="PanelContainer" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxSection")

[node name="Margin" type="MarginContainer" parent="SettingsScroll/Content/DataPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="DataActions" type="VBoxContainer" parent="SettingsScroll/Content/DataPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="BackupDescription" type="Label" parent="SettingsScroll/Content/DataPanel/Margin/DataActions"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.35, 0.35, 1)
theme_override_font_sizes/font_size = 23
text = "덱, 학습 기록, 즐겨찾기, 설정을 ZIP 하나로 보관합니다."
autowrap_mode = 3

[node name="CreateBackupButton" type="Button" parent="SettingsScroll/Content/DataPanel/Margin/DataActions"]
custom_minimum_size = Vector2(0, 78)
layout_mode = 2
theme_override_font_sizes/font_size = 27
text = "전체 백업"

[node name="Separator" type="HSeparator" parent="SettingsScroll/Content/DataPanel/Margin/DataActions"]
layout_mode = 2
theme_override_styles/separator = SubResource("StyleBoxSeparator")

[node name="RestoreBackupButton" type="Button" parent="SettingsScroll/Content/DataPanel/Margin/DataActions"]
custom_minimum_size = Vector2(0, 78)
layout_mode = 2
theme_override_font_sizes/font_size = 27
text = "전체 복원"

[node name="RestoreDescription" type="Label" parent="SettingsScroll/Content/DataPanel/Margin/DataActions"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.45, 0.45, 1)
theme_override_font_sizes/font_size = 21
text = "백업에 포함된 데이터로 현재 앱 데이터를 교체합니다."
autowrap_mode = 3

[node name="TipsTitle" type="Label" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "덱 만들기 팁"

[node name="TipsPanel" type="PanelContainer" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxSection")

[node name="Margin" type="MarginContainer" parent="SettingsScroll/Content/TipsPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="TipsContent" type="VBoxContainer" parent="SettingsScroll/Content/TipsPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TipTitleLabel" type="Label" parent="SettingsScroll/Content/TipsPanel/Margin/TipsContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 25
text = "단어장 사진으로 덱 만들기"
autowrap_mode = 3

[node name="TipDescription" type="Label" parent="SettingsScroll/Content/TipsPanel/Margin/TipsContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.35, 0.35, 1)
theme_override_font_sizes/font_size = 23
text = "1. 아래 버튼으로 AI 프롬프트를 복사합니다.
2. AI 앱에 단어장 사진과 함께 붙여넣습니다.
3. 답변을 복사한 뒤 덱 목록의 ⋮에서 '클립보드에서 만들기'를 누릅니다."
autowrap_mode = 3

[node name="CopyAiPromptButton" type="Button" parent="SettingsScroll/Content/TipsPanel/Margin/TipsContent"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 78)
layout_mode = 2
theme_override_font_sizes/font_size = 27
text = "AI 프롬프트 복사"

[node name="InfoTitle" type="Label" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "정보"

[node name="InfoPanel" type="PanelContainer" parent="SettingsScroll/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxSection")

[node name="Margin" type="MarginContainer" parent="SettingsScroll/Content/InfoPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 22

[node name="Content" type="VBoxContainer" parent="SettingsScroll/Content/InfoPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="PrivacyPolicyLink" type="LinkButton" parent="SettingsScroll/Content/InfoPanel/Margin/Content"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/font_hover_color = Color(0, 0, 0, 1)
theme_override_colors/font_pressed_color = Color(0, 0, 0, 1)
theme_override_colors/font_focus_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 25
text = "개인정보처리방침"
underline = 1
alignment = 0

[node name="AppVersionLabel" type="Label" parent="SettingsScroll/Content/InfoPanel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.45, 0.45, 1)
theme_override_font_sizes/font_size = 21
text = "버전"

[node name="BackupDialog" type="FileDialog" parent="."]
title = "전체 백업 저장"
initial_position = 2
size = Vector2i(720, 900)

[node name="RestoreDialog" type="FileDialog" parent="."]
title = "복원할 백업 선택"
initial_position = 2
size = Vector2i(720, 900)

[editable path="Header"]

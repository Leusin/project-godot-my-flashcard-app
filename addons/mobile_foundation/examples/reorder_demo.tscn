[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/mobile_foundation/examples/reorder_demo.gd" id="1"]

[node name="ReorderDemo" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
text = "재정렬 컴포넌트 확인"
theme_override_font_sizes/font_size = 32

[node name="Status" type="Label" parent="Content"]
layout_mode = 2
text = "위 목록은 바로 끌기, 아래 타일은 0.45초 길게 누르기"
autowrap_mode = 2

[node name="Rows" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Tiles" type="HFlowContainer" parent="Content"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
